  "reactSnap": {
    "include": [
      "/",
      "/blogs",
      "/blog/*",
      "/faqs",
      "/services/*",
      "/why-Unsaathi",
      "/how-Unsaathi",
      "/About-Us",
      "/connect-With-Us",
      "/contact",
      "/quiz",
      "/divorce-lawyer-noida",
      "/divorce-lawyer-delhi",
      "/divorce-lawyer-gurgaon"
    ],
